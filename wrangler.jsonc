{
  "name": "fuel-prices-api",
  "main": "build/worker/shim.mjs",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fuel-prices",
      "database_id": "415e90d3-274e-4a01-8e54-af698212fc9a"
    }
  ],
  // Cloudflare cron dialect: weekdays are numbered from Sunday = 1, so use a name.
  "triggers": { "crons": ["0 0 1-15 * FRI"] }
}
